package taller2;

import java.io.File;
import java.io.IOException;
import java.util.Scanner;

public class App {
	// Contador general de registros cargados (choripanes + terremotos)
	static int totalRegistros = 0;
	// Arreglo y contador de choripanes registrados
	static Choripan[] choripanes = new Choripan[200];
	static int totalChoripanes = 0;
	// Arreglo y contador de terremotos registrados
	static Terremoto[] terremotos = new Terremoto[200];
	static int totalTerremotos = 0;
	// Arreglo y contador de participantes
	static String[] participantes = new String[200];
	static int totalParticipantes = 0;

	
	public static void main(String[] args) throws IOException {
		Scanner scanner = new Scanner(System.in);
		// Carga inicial de datos desde los archivos de texto
		cargarParticipantes();
		cargarConsumido();

		int opcion = 0;
		
		do {
			System.out.println("============================================");
			System.out.println("           LA FONDA DEL PAPU                ");
			System.out.println("============================================");
			System.out.printf("  Registros cargados: %s \n", totalRegistros);
			System.out.println("--------------------------------------------");
			System.out.println("  [1] Ver registros");
			System.out.println("  [2] Actualizar registros");
			System.out.println("  [3] Calcular metricas");
			System.out.println("  [4] Salir");
			System.out.println("============================================");
			System.out.print("Seleccione una opcion: ");

			try {

				opcion = Integer.parseInt(scanner.nextLine());

			} catch (NumberFormatException e) {

				System.out.println(">> Error: la opcion debe ser un numero entre 1 y 4. Intente nuevamente.\n");

				continue;

			}
			if (opcion == 1) {
				verRegistros();

			}else if (opcion == 2) {
				actualizarRegistros();
				
			}else if (opcion == 4) {

				System.out.println("Cerrando programa... Hasta pronto!");

			}else {
				System.out.println(">> Error: opcion fuera de rango. Intente nuevamente.\n");
			}
		}while (opcion != 4);

		scanner.close();
	}

	/**
	 * Muestra el submenu de actualizacion de registros
	 * (agregar, editar, eliminar).
	 */
	private static void actualizarRegistros() {
		Scanner scanner = new Scanner(System.in);
		int opcion = 0;
		
		do {
			System.out.println("========== ACTUALIZAR REGISTROS ============");
			System.out.println("[1] Agregar");
			System.out.println("[2] Editar");
			System.out.println("[3] Eliminar");
			System.out.println("[4] Volver al menu principal");
			System.out.println("============================================");
			System.out.println("Seleccione una opción: ");
			
			try {
				opcion = Integer.parseInt(scanner.nextLine());
			} catch (NumberFormatException e) {
				System.out.println(">> Error: la opcion debe ser un numero entre 1 y 4. Intente nuevamente.\n");
				continue;
			}
			if (opcion == 1) {
				elegirRegistro("Tipo de registro a agregar");
				int tipo = leerOpcion(scanner, 1, 3);
				if (tipo == 3) return;
				
			}
			
		}while (opcion != 4);
		scanner.close();
	}

	/**
	 * Lee una opcion numerica desde consola y la repite hasta que sea valida.
	 *
	 * @param scanner Scanner usado para leer la entrada
	 * @param min     valor minimo permitido
	 * @param max     valor maximo permitido
	 * @return la opcion ingresada dentro del rango [min, max]
	 */
	private static int leerOpcion(Scanner scanner, int min, int max) {
		int opcion = 0;
		boolean valida = false;
		do {
	        System.out.print("Seleccione una opcion: ");
	        String entrada = scanner.nextLine().trim();
	        if (entrada.isEmpty()) {
	            System.out.println(">> Error: no ingreso ninguna opcion. Intente nuevamente.");
	        } else {
	            try {
	                opcion = Integer.parseInt(entrada);
	                if (opcion >= min && opcion <= max) {
	                    valida = true;
	                } else {
	                    System.out.println(">> Error: opcion fuera de rango. Intente nuevamente.");
	                }
	            } catch (NumberFormatException e) {
	                System.out.println(">> Error: la opcion debe ser un numero entre "
	                        + min + " y " + max + ". Intente nuevamente.");
	            }
	        }
	    } while (!valida);
		
		return opcion;
	}

	/**
	 * Muestra el menu para elegir el tipo de registro.
	 *
	 * @param titulo texto que se muestra como encabezado del menu
	 */
	private static void elegirRegistro(String titulo) {
		System.out.println("\n" + titulo + ":");
	    System.out.println("  [1] Choripan");
	    System.out.println("  [2] Terremoto");
	    System.out.println("  [3] Cancelar");

	}

	/**
	 * Carga los registros de consumo desde el archivo "Consumido.txt"
	 * y los guarda en los arreglos de choripanes y terremotos.
	 *
	 * @throws IOException si ocurre un error de lectura de archivos
	 */
	private static void cargarConsumido() throws IOException {
		File file = new File("Consumido.txt");
		Scanner lector = null;
		// Si el archivo no existe, se avisa y se continua sin registros
		try {
			lector = new Scanner(file);
		} catch (IOException e) {
			System.out.println(">> ADVERTENCIA: no se encontro el archivo \"Consumido.txt\".");
			System.out.println("   Se iniciara el programa sin registros previos.");
			return;
		}

		// Se lee el archivo linea por linea (campos separados por ";")
		while (lector.hasNextLine()) {
			String linea = lector.nextLine();
			String[] partes = linea.split(";");
			String tipo = partes[0];
			String consumidor = partes[1];

			// Registro de tipo Choripan: tipo;consumidor;largo;ancho;fecha
			if (tipo.equalsIgnoreCase("Choripan")) {
				double largo = Double.parseDouble(partes[2]);
				double ancho = Double.parseDouble(partes[3]);
				String fecha = partes[4];

				// Se verifica que quede espacio en el arreglo
				if (totalChoripanes >= choripanes.length) {
					System.out.println(">> Error: se alcanzo la capacidad maxima de registros de choripanes (200).");
					continue;
				}

				choripanes[totalChoripanes] = new Choripan(consumidor, largo, ancho, fecha);
				totalChoripanes++;
				totalRegistros++;

			// Registro de tipo Terremoto: tipo;consumidor;litros;fecha
			} else if (tipo.equalsIgnoreCase("Terremoto")) {
				double litros = Double.parseDouble(partes[2]);
				String fecha = partes[3];

				if (totalChoripanes >= choripanes.length) {
					System.out.println(">> Error: se alcanzo la capacidad maxima de registros de choripanes (200).");
					continue;
				}
				terremotos[totalTerremotos] = new Terremoto(consumidor, litros, fecha);
				totalTerremotos++;
				totalRegistros++;

			}

		}
		lector.close();
	}

	/**
	 * Carga la lista de participantes desde el archivo "Participantes.txt"
	 * @throws IOException si ocurre un error de lectura de archivos
	 */
	private static void cargarParticipantes() throws IOException {
		File file = new File("Participantes.txt");
		Scanner lector = null;
		// Si el archivo no existe, se avisa y se continua sin registros
		try {
			lector = new Scanner(file);
		} catch (IOException e) {
			System.out.println(">> ADVERTENCIA: no se encontro el archivo \"Participantes.txt\".");
			System.out.println("   Se iniciara el programa sin registros previos.");
			return;
		}
		
		while (lector.hasNextLine()) {
			String linea = lector.nextLine();
			participantes[totalParticipantes] = linea;

			totalParticipantes++;
		}
		lector.close();

	}

	/*
	 * Opcion 1 - (Registros choripanes - terremotos)
	 * 
	 */
	/**
	 * Muestra el submenu para ver los registros de choripanes o terremotos,
	 * con sus datos, calorias y totales.
	 */
	private static void verRegistros() {
		Scanner scanner = new Scanner(System.in);
		int opcion = 0;

		do {

			System.out.println("============ VER REGISTROS =================");
			System.out.println("  [1] Choripanes");
			System.out.println("  [2] Terremotos");
			System.out.println("  [3] Volver al menu principal");
			System.out.println("============================================");
			System.out.print("Seleccione una opcion: ");

			try {

				opcion = Integer.parseInt(scanner.nextLine());

			} catch (NumberFormatException e) {

				System.out.println(">> Error: la opcion debe ser un numero entre 1 y 3. Intente nuevamente.\n");

				continue;

			}
			System.out.println("");
			// Listado de choripanes con su cantidad de calorias
			if (opcion == 1) {
				System.out.println("=============== CHORIPANES =================");
				System.out.println("  #   Consumidor    Largo   Ancho   Fecha         KCal");
				int total = 0;
				for (int i = 0; i < totalChoripanes; i++) {
					total++;
					System.out.println("  " + (i + 1) + "   " + choripanes[i].getConsumidor() + "       "
							+ choripanes[i].getLargo() + " cm    " + choripanes[i].getAncho() + " cm  "
							+ choripanes[i].getFecha() + "  "
							+ String.format("%.2f", choripanes[i].calculoKCalorias()));
				}

				System.out.println("--------------------------------------------------");
				System.out.println("   Total: " + total + " choripanes registrados");
				System.out.println("==================================================");
				System.out.println("");

			// Listado de terremotos, acumulando el total de litros
			} else if (opcion == 2) {
				System.out.println("=============== TERREMOTOS =================");
				System.out.println("  #   Consumidor    Litros   Fecha         KCal");
				int total = 0;
				double sumaLitros = 0.0;
				for (int i = 0; i < totalTerremotos; i++) {
					total++;
					sumaLitros += terremotos[i].getLitros();
					System.out.println("  " + (i + 1) + "   " + terremotos[i].getConsumidor() + "       "
							+ String.format("%.2f", terremotos[i].getLitros()) + " L     " + terremotos[i].getFecha()
							+ "  " + String.format("%.2f", terremotos[i].calculoKCalorias()));
				}

				System.out.println("--------------------------------------------------");
				System.out.println(
						"   Total: " + total + " terremotos registrados (" + String.format("%.2f", sumaLitros) + " L)");
				System.out.println("==================================================");
				System.out.println("");

			}else {
				System.out.println("Opción fuera de rango, ingrese nuevamente. ");
			}

		} while (opcion != 3);
		scanner.close();
	}
}