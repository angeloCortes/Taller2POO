						"   Total: " + total + " terremotos registrados (" + String.format("%.2f", sumaLitros) + " L)");
				System.out.println("==================================================");
				System.out.println("");

			}else {
				System.out.println("Opción fuera de rango, ingrese nuevamente. ");
			}

		} while (opcion != 3);
	}
