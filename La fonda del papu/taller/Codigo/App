							+ choripanes[i].getFecha() + "  "
							+ String.format("%.2f", choripanes[i].calculoKCalorias()));
				}

				System.out.println("--------------------------------------------------");
				System.out.println("   Total: " + total + " choripanes registrados");
				System.out.println("==================================================");
				System.out.println("");

			// Listado de terremotos, acumulando el total de litros
			} else if (opcion == 2) {
				System.out.println("=============== TERREMOTOS =================");
				System.out.println("  #   Consumidor    Litros   Fecha         KCal");
				int total = 0;
				double sumaLitros = 0.0;
				for (int i = 0; i < totalTerremotos; i++) {
					total++;
					sumaLitros += terremotos[i].getLitros();
					System.out.println("  " + (i + 1) + "   " + terremotos[i].getConsumidor() + "       "
							+ String.format("%.2f", terremotos[i].getLitros()) + " L     " + terremotos[i].getFecha()
							+ "  " + String.format("%.2f", terremotos[i].calculoKCalorias()));
