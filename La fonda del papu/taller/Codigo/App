	/* Decimal opcional: vacio mantiene el valor actual (largo, ancho o litros) */
	private static double decimalOpcional(Scanner scanner, String etiqueta, double actual) {
	    double valor = actual;
	    boolean valido = false;

	    do {
	        System.out.print(etiqueta + " [" + actual + "]: ");
	        String entrada = scanner.nextLine().trim().replace(',', '.');

	        if (entrada.isEmpty()) {
	            valor = actual;
	            valido = true;
	        } else {
	            try {
	                valor = Double.parseDouble(entrada);
	                if (valor > 0 && !Double.isInfinite(valor)) {
	                    valido = true;
	                } else {
	                    System.out.println(">> Error: ingrese un numero mayor a 0");
	                }
	            } catch (NumberFormatException e) {
	                System.out.println(">> Error: ingrese una opcion numerica valida (EJ: 1.5)");
	            }
	        }
	    } while (!valido);

	    return valor;
	}

	/* Fecha opcional: vacio mantiene la actual */
	private static String fechaOpcional(Scanner scanner, String actual) {
	    String fecha = actual;
	    boolean valida = false;

	    do {
	        System.out.print("Fecha [" + actual + "]: ");
	        String entrada = scanner.nextLine().trim();

	        if (entrada.isEmpty()) {
	            fecha = actual;
	            valida = true;
	        } else if (esFechaValida(entrada)) {
	            fecha = entrada;
	            valida = true;
	        } else {
	            System.out.println(">> Error: la fecha debe tener formato YYYY-MM-DD y ser valida. Intente nuevamente.");
	        }
	    } while (!valida);

	    return fecha;
	}
	
	/* Consumidor opcional: muestra los disponibles; vacio mantiene el actual, si no debe existir */
	private static String consumidorOpcional(Scanner scanner, String actual) {
	    /*esto por si no hay participantes cargados*/
	    if (totalParticipantes == 0) {
	        return actual;
	    }

	    System.out.println("Consumidores disponibles:");
	    for (int i = 0; i < totalParticipantes; i++) {
	        System.out.println("  - " + participantes[i]);
	    }

	    String consumidor = actual;
	    boolean valido = false;

	    do {
	        System.out.print("Consumidor [" + actual + "]: ");
	        String entrada = scanner.nextLine().trim();

	        if (entrada.isEmpty()) {
	            consumidor = actual;
	            valido = true;
	        } else {
	            int indice = buscarParticipante(entrada);
	            if (indice != -1) {
	                consumidor = participantes[indice];
	                valido = true;
	            } else {
	                System.out.println(">> Error: el consumidor no existe en la lista de participantes. Intente nuevamente.");
	            }
	        }
	    } while (!valido);

	    return consumidor;
	}

	/* Devuelve la posicion del participante a la lista, o -1 si no existe */
	private static int buscarParticipante(String nombre) {
	    for (int i = 0; i < totalParticipantes; i++) {
	        if (participantes[i].equalsIgnoreCase(nombre)) {
	            return i;
	        }
	    }
	    return -1;
	}
	
	private static boolean guardarConsumido() {
		 try {
		        FileWriter archivo = new FileWriter("Consumido.txt");
		        BufferedWriter escritor = new BufferedWriter(archivo);

		        for (int i = 0; i < totalChoripanes; i++) {
		            escritor.write(choripanes[i].toLineaArchivo());
		            escritor.newLine();
		        }
		        for (int i = 0; i < totalTerremotos; i++) {
		            escritor.write(terremotos[i].toLineaArchivo());
		            escritor.newLine();
		        }

		        escritor.close();
		        return true;
		    } catch (IOException e) {
		        System.out.println(">> Error: no se pudo guardar en Consumido.txt.");
		        return false;
		    }
		
	}

	/*Función para ingresar las fechas*/
	private static String ingresoFecha(Scanner scanner, String mensaje) {
		String fecha = "";
	    boolean valida = false;

	    do {
	        System.out.print(mensaje);
	        fecha = scanner.nextLine().trim();

	        if (esFechaValida(fecha)) {
	            valida = true;
	        } else {
	            System.out.println(">> Error: la fecha debe tener formato YYYY-MM-DD y ser una fecha real. Intente nuevamente.");
	        }
	    } while (!valida);

		return fecha;
	}
	/*Valida que el formato de la fecha sea valido*/
	private static boolean esFechaValida(String fecha) {
		 if (fecha.length() != 10 || fecha.charAt(4) != '-' || fecha.charAt(7) != '-') {
		        return false;
		    }

		    try {
		        int anio = Integer.parseInt(fecha.substring(0, 4));
		        int mes = Integer.parseInt(fecha.substring(5, 7));
		        int dia = Integer.parseInt(fecha.substring(8, 10));

		        if (anio < 1 || mes < 1 || mes > 12) {
		            return false;
		        }
		        return dia >= 1 && dia <= diasDelMes(anio, mes);
		    } catch (NumberFormatException e) {
		        return false;
		    }
	}
	/*En caso de años bisiestos*/
	private static int diasDelMes(int anio, int mes) {
		 switch (mes) {
	        case 4: case 6: case 9: case 11:
	            return 30;
	        case 2:
	            boolean bisiesto = (anio % 4 == 0 && anio % 100 != 0) || anio % 400 == 0;
	            return bisiesto ? 29 : 28;
	        default:
	            return 31;
	    }
	}

